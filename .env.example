# Server-only settings for the /api/ai function. Set them in Vercel → Project → Settings → Environment Variables.
# Never prefix these with VITE_: nothing here may reach the browser bundle.

# Google Gemini API key (required for AI features; without it every AI task falls back to built-in rules).
GEMINI_API_KEY=
# Optional comma-separated model chain, tried in order.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Upstash Redis REST credentials for distributed rate limiting (the Vercel Marketplace integration sets KV_* names).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional salt for hashing client IPs before they are used as rate-limit keys.
RATE_LIMIT_SALT=
